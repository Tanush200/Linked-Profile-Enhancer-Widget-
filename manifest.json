{
  "manifest_version": 3,
  "name": "LinkedIn Profile Widget",
  "version": "1.0",
  "description": "Display a custom widget on LinkedIn profiles with match score and status.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.linkedin.com/in/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Toggle LinkedIn Widget"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["content.js"]
    }
  ]
}
